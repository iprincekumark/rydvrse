# ============================================================
# RYDVRSE — Environment Configuration Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in ALL values marked with <REPLACE_ME>
#   3. NEVER commit the .env file to Git
#   4. For production, use a secrets manager (AWS SSM, Vault)
# ============================================================

# ===================== APPLICATION =====================
APP_NAME=rydvrse
APP_ENV=development
APP_PORT=8080
APP_CONTEXT_PATH=/api
APP_LOG_LEVEL=INFO

# ===================== DATABASE (PostgreSQL) =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rydvrse
DB_USERNAME=rydvrse
DB_PASSWORD=<REPLACE_ME_WITH_STRONG_PASSWORD>
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_POOL_MAX=25
DB_SSL_ENABLED=false

# ===================== REDIS =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REPLACE_ME_OR_LEAVE_EMPTY_FOR_LOCAL>
REDIS_DATABASE=0
REDIS_TIMEOUT=5000

# ===================== KAFKA =====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=rydvrse-platform
KAFKA_AUTO_OFFSET_RESET=earliest

# ===================== JWT / SECURITY =====================
JWT_SECRET=<REPLACE_ME_WITH_256_BIT_SECRET_KEY>
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=rydvrse.com

# ===================== OTP (SMS Gateway) =====================
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_MAX_RETRIES=3
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=<REPLACE_ME>
SMS_AUTH_TOKEN=<REPLACE_ME>
SMS_FROM_NUMBER=<REPLACE_ME>

# ===================== PAYMENT GATEWAY (Razorpay) =====================
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=<REPLACE_ME>
RAZORPAY_KEY_SECRET=<REPLACE_ME>
RAZORPAY_WEBHOOK_SECRET=<REPLACE_ME>
PLATFORM_COMMISSION_PCT=20.0

# ===================== PUSH NOTIFICATIONS (Firebase) =====================
FCM_ENABLED=false
FCM_PROJECT_ID=<REPLACE_ME>
FCM_SERVICE_ACCOUNT_KEY_PATH=<REPLACE_ME_PATH_TO_SERVICE_ACCOUNT_JSON>

# ===================== EMAIL (SendGrid) =====================
EMAIL_ENABLED=false
SENDGRID_API_KEY=<REPLACE_ME>
SENDGRID_FROM_EMAIL=no-reply@rydvrse.com
SENDGRID_FROM_NAME=RYDVRSE

# ===================== FILE STORAGE (AWS S3) =====================
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<REPLACE_ME>
AWS_ACCESS_KEY_ID=<REPLACE_ME>
AWS_SECRET_ACCESS_KEY=<REPLACE_ME>

# ===================== DISPATCH / MATCHING =====================
DISPATCH_SEARCH_RADIUS_KM=10.0
DISPATCH_TIMEOUT_SECONDS=30
DISPATCH_MAX_RETRIES=3

# ===================== PRICING =====================
PRICING_DEFAULT_BASE_FARE=50.0
PRICING_DEFAULT_PER_KM=12.0
PRICING_DEFAULT_PER_MIN=2.0
PRICING_MINIMUM_FARE=80.0
PRICING_SURGE_MULTIPLIER_CAP=3.0

# ===================== CORS =====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# ===================== MONITORING (Optional) =====================
ACTUATOR_ENABLED=true
PROMETHEUS_ENABLED=false
GRAFANA_URL=<REPLACE_ME>

# ===================== SPRINGDOC / SWAGGER =====================
SWAGGER_ENABLED=true
SWAGGER_TITLE=RYDVRSE Platform API
SWAGGER_VERSION=1.0.0

# ===================== DOCKER (for docker-compose) =====================
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=bitnami/kafka:3.7
