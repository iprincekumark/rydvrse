    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|@react-navigation/.*|react-native-safe-area-context|react-native-gesture-handler|react-redux|@reduxjs/toolkit|immer))"
