<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.rydvrse</groupId>
    <artifactId>rydvrse-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RYDVRSE Platform</name>
    <description>Enterprise-grade On-Demand Driver Marketplace — Modular Monolith</description>

    <modules>
        <module>rydvrse-shared</module>
        <module>rydvrse-auth</module>
        <module>rydvrse-user</module>
        <module>rydvrse-driver</module>
        <module>rydvrse-vehicle</module>
        <module>rydvrse-location</module>
        <module>rydvrse-trip</module>
        <module>rydvrse-dispatch</module>
        <module>rydvrse-pricing</module>
        <module>rydvrse-payment</module>
        <module>rydvrse-wallet</module>
        <module>rydvrse-notification</module>
        <module>rydvrse-support</module>
        <module>rydvrse-admin</module>
        <module>rydvrse-operations</module>
        <module>rydvrse-safety</module>
        <module>rydvrse-analytics</module>
        <module>rydvrse-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <lombok.version>1.18.36</lombok.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <jjwt.version>0.12.5</jjwt.version>
        <springdoc.version>2.3.0</springdoc.version>
        <guava.version>33.0.0-jre</guava.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-driver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-vehicle</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-location</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-trip</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-dispatch</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-pricing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-wallet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-operations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-safety</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.rydvrse</groupId>
                <artifactId>rydvrse-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- API Docs -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Guava -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>



    <!-- Dependencies inherited by ALL modules -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
